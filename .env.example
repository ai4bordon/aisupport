# Шаблон переменных окружения. Значения не коммитятся.
# Строка подключения передаётся лично от владельца, в репозиторий не пишется.

# База данных
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/support_agent_01

# Модель и векторы
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/inference/go
LLM_MODEL=deepseek-v4.1-flash
EMBEDDING_MODEL=qwen3-embedding-8b

# MAX Bot API
MAX_BOT_TOKEN=
MAX_BOT_NAME=

# Доступ к стенду
ACCESS_CODE=
SESSION_SECRET=

# Лимиты стенда
DAILY_DIALOG_LIMIT=50
REQUESTS_PER_MINUTE=10
ESCALATION_MODE=off
MODEL_USD_TO_RUB=100
MODEL_BUDGET_PER_DAY_RUB=300
MODEL_BUDGET_PER_HOUR_RUB=30
